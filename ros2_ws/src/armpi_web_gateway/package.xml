<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>armpi_web_gateway</name>
  <version>0.2.0</version>
  <description>로봇 안 웹 조종기(HTTP 18765, 휴대폰·PC 화면) C++ 노드. 조종은 Protocol v3 UDP(127.0.0.1:5001)로만, 상태·서비스는 rclcpp</description>
  <maintainer email="noreply@example.invalid">ArmPro_Cpp_ROS2 contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>armpi_common</depend>
  <depend>armpi_protocol</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
